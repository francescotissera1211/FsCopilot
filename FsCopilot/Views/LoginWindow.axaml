<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FsCopilot.ViewModels"
        xmlns:a11y="using:FsCopilot.Accessibility"
        x:Class="FsCopilot.Views.LoginWindow"
        x:DataType="vm:LoginViewModel"
        Title="FS Copilot - Connection settings"
        Width="500"
        Height="720"
        CanResize="False"
        Background="Black"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        RequestedThemeVariant="Dark">

    <Window.Resources>
        <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="#444444" />
        <SolidColorBrush x:Key="TextControlSelectionForegroundColor" Color="#CCCCCC" />
        <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#3D82FF" />
        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#1A1A1A" />
    </Window.Resources>

    <Window.Styles>
        <Style Selector="Button.cta">
            <Setter Property="Margin" Value="0,24,0,0" />
            <Setter Property="MinWidth" Value="220" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Padding" Value="34,0" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#3D82FF" Offset="0" />
                    <GradientStop Color="#0D5AE8" Offset="1" />
                </LinearGradientBrush>
            </Setter>
        </Style>

        <Style Selector="Button.cta:pointerover">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#4B8CFF" Offset="0" />
                    <GradientStop Color="#1A66F0" Offset="1" />
                </LinearGradientBrush>
            </Setter>
        </Style>

        <Style Selector="Button.cta:pressed">
            <Setter Property="Opacity" Value="0.96" />
        </Style>

        <Style Selector="Button.cta:disabled">
            <Setter Property="Opacity" Value="0.55" />
        </Style>

        <Style Selector="TextBox.input">
            <Setter Property="Background" Value="#1A1A1A" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#333333" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="SelectionBrush" Value="#333333" />
            <Setter Property="SelectionForegroundBrush" Value="#CCCCCC" />
            <Setter Property="CaretBrush" Value="#AAAAAA" />
        </Style>

        <Style Selector="TextBox.input:focus">
            <Setter Property="BorderBrush" Value="#3D82FF" />
        </Style>

        <Style Selector="TextBlock.label">
            <Setter Property="Foreground" Value="#AAAAAA" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,16,0,0" />
        </Style>

        <Style Selector="TextBlock.error">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#FF5555" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,12,0,0" />
        </Style>
    </Window.Styles>

    <Grid Background="Black">
        <ScrollViewer>
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="0"
                    Margin="60,32">

            <TextBlock Text="FS Copilot"
                       AutomationProperties.HeadingLevel="1"
                       HorizontalAlignment="Center"
                       FontSize="42"
                       FontWeight="SemiBold"
                       TextAlignment="Center"
                       Margin="0,0,0,8">
                <TextBlock.Foreground>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="White" Offset="0" />
                        <GradientStop Color="#B8D1FF" Offset="1" />
                    </LinearGradientBrush>
                </TextBlock.Foreground>
            </TextBlock>

            <TextBlock Text="Connection settings"
                       AutomationProperties.HeadingLevel="2"
                       HorizontalAlignment="Center"
                       Foreground="#CCCCCC"
                       FontSize="18"
                       Margin="0,0,0,20" />

            <TextBlock x:Name="ServerLabel"
                       Classes="label"
                       Text="Server address" />
            <TextBox x:Name="ServerBox"
                     Classes="input"
                     AutomationProperties.Name="Server address"
                     AutomationProperties.LabeledBy="{Binding #ServerLabel}"
                     AutomationProperties.IsRequiredForForm="True"
                     AutomationProperties.HelpText="Default p2p.fscopilot.com"
                     Text="{Binding ServerAddress}"
                     Watermark="p2p.fscopilot.com"
                     SelectionBrush="#333333"
                     SelectionForegroundBrush="#CCCCCC"
                     CaretBrush="#AAAAAA" />

            <TextBlock x:Name="UsernameLabel"
                       Classes="label"
                       Text="Username" />
            <TextBox Classes="input"
                     AutomationProperties.Name="Username"
                     AutomationProperties.LabeledBy="{Binding #UsernameLabel}"
                     AutomationProperties.IsRequiredForForm="True"
                     AutomationProperties.HelpText="Shown to your crew"
                     Text="{Binding Username}"
                     Watermark="By default will be your System username"
                     SelectionBrush="#333333"
                     SelectionForegroundBrush="#CCCCCC"
                     CaretBrush="#AAAAAA" />

            <TextBlock x:Name="PeerIdLabel"
                       Classes="label"
                       Text="Peer ID (your client code)" />
            <DockPanel>
            <Button DockPanel.Dock="Right"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    Content="New ID"
                    AutomationProperties.HelpText="Makes a new random peer ID"
                    Command="{Binding NewIdCommand}" />
            <TextBox Classes="input"
                     AutomationProperties.Name="Peer ID"
                     AutomationProperties.LabeledBy="{Binding #PeerIdLabel}"
                     AutomationProperties.IsRequiredForForm="True"
                     AutomationProperties.HelpText="Generated for you; your crew joins with it"
                     MaxLength="8"
                     Text="{Binding PeerId}"
                     Watermark="8 letters or digits"
                     SelectionBrush="#333333"
                     SelectionForegroundBrush="#CCCCCC"
                     CaretBrush="#AAAAAA" />
            </DockPanel>

            <TextBlock x:Name="ModeLabel"
                       Classes="label"
                       Text="Connection type" />
            <ComboBox AutomationProperties.Name="Connection type"
                      AutomationProperties.LabeledBy="{Binding #ModeLabel}"
                      AutomationProperties.HelpText="Automatic tries direct, then relay"
                      HorizontalAlignment="Stretch"
                      ItemsSource="{Binding ConnectionModeOptions}"
                      SelectedItem="{Binding ConnectionMode}" />

            <CheckBox Margin="0,16,0,0"
                      Foreground="White"
                      IsChecked="{Binding ShareGroundVehicles}"
                      Content="Share ground vehicles when hosting traffic" />

            <TextBlock Classes="error"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       Text="{Binding ErrorMessage}" />

            <Button Classes="cta"
                    IsDefault="True"
                    Content="{Binding SaveLabel}"
                    Command="{Binding ConnectCommand}"
                    HorizontalAlignment="Center" />

            <TextBlock Foreground="#888888"
                       FontSize="12"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Margin="0,16,0,0"
                       Text="{Binding ConfigPath, StringFormat='Saved to {0}'}" />

            <a11y:LiveAnnouncer />
        </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
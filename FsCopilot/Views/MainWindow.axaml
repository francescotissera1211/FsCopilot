<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FsCopilot.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:fsCopilot="clr-namespace:FsCopilot"
        xmlns:a11y="using:FsCopilot.Accessibility"
        mc:Ignorable="d"
        d:DesignWidth="500"
        d:DesignHeight="800"
        Width="500"
        Height="800"
        CanResize="False"
        RequestedThemeVariant="Dark"
        x:Class="FsCopilot.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/fscopilot.ico"
        Title="FS Copilot"
        TransparencyLevelHint="AcrylicBlur"
        Background="Transparent"
        ExtendClientAreaToDecorationsHint="True">

    <Window.Resources>
        <fsCopilot:StringNotEmptyToBool x:Key="NotEmpty"/>
        <fsCopilot:StringEmptyToBool x:Key="Empty"/>
        <fsCopilot:InverseBool x:Key="Inverse"/>
        <fsCopilot:BoolToWait x:Key="Wait"/>
        <fsCopilot:QualityToBrush x:Key="QualityToBrush"/>
    </Window.Resources>

    <Window.Styles>
        <StyleInclude Source="./MainWindowStyles.axaml" />
    </Window.Styles>

    <Window.Cursor>
        <Binding Path="IsBusy" Converter="{StaticResource Wait}"/>
    </Window.Cursor>

    <!-- <Design.DataContext> -->
    <!--     <vm:DesignMainViewModel /> -->
    <!-- </Design.DataContext> -->

    <Panel>
        <ExperimentalAcrylicBorder IsHitTestVisible="False">
            <ExperimentalAcrylicBorder.Material>
                <ExperimentalAcrylicMaterial
                    BackgroundSource="Digger"
                    TintColor="Black"
                    TintOpacity="1"
                    MaterialOpacity="0.65" />
            </ExperimentalAcrylicBorder.Material>
        </ExperimentalAcrylicBorder>

        <Grid Classes="Wrapper" RowDefinitions="Auto,Auto,Auto,*,Auto">
            <Border Grid.Row="0"
                    Classes="Card">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right"
                                Orientation="Vertical"
                                VerticalAlignment="Center"
                                Margin="0,0,8,0">
                        <TextBlock Classes="Name"
                                   AutomationProperties.HeadingLevel="1"
                                   Text="FS Copilot"  />
                        <TextBlock Classes="Version"
                                   Text="{Binding Version, StringFormat='v{0}'}" />
                    </StackPanel>

                    <Border DockPanel.Dock="Left" Classes="MainIcon">
                        <PathIcon Data="{StaticResource airplane_regular}">
                            <PathIcon.RenderTransform>
                                <RotateTransform Angle="-45" />
                            </PathIcon.RenderTransform>
                        </PathIcon>
                    </Border>
                    <DockPanel DockPanel.Dock="Left">
                        <DockPanel DockPanel.Dock="Bottom">
                            <Button DockPanel.Dock="Right"
                                    Classes="Link"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Content="Settings"
                                    AutomationProperties.HelpText="Saving restarts FS Copilot"
                                    Click="OnSettingsClick" />
                            <Button DockPanel.Dock="Right"
                                    Classes="Link"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Content="Copy code"
                                    AutomationProperties.Name="Copy code"
                                    Command="{Binding CopyCodeCommand}" />
                            <SelectableTextBlock Classes="PeerId"
                                       AutomationProperties.HelpText="Your code"
                                       Text="{Binding PeerId}" />
                        </DockPanel>
                        <TextBlock Classes="ClientName"
                                   DockPanel.Dock="Top"
                                   Text="{Binding ClientName}" />
                    </DockPanel>
                </DockPanel>
            </Border>

            <Border Grid.Row="1"
                    Classes="Card">
                <StackPanel Spacing="10">
                    <DockPanel>
                        <PathIcon Classes="CardTitle"
                                  Data="{StaticResource plug_disconnected_regular}" />
                        <TextBlock Classes="CardTitle"
                                   Text="Connection" />
                    </DockPanel>

                    <!-- Tab order inside this row only: the code box, then Join, Leave, Take Control. -->
                    <DockPanel KeyboardNavigation.TabNavigation="Local">
                        <Button DockPanel.Dock="Right"
                                Classes="TakeControl"
                                Content="Take Control"
                                KeyboardNavigation.TabIndex="3"
                                AutomationProperties.HelpText="Fly the aircraft yourself"
                                IsEnabled="{Binding ShowTakeControl}"
                                Command="{Binding TakeControlCommand}"/>
                        <Button DockPanel.Dock="Right"
                                Classes="Leave"
                                Content="Leave"
                                KeyboardNavigation.TabIndex="2"
                                Command="{Binding LeaveCommand}"
                                IsEnabled="{Binding Connected}" />
                        <Button DockPanel.Dock="Right"
                                Classes="Connect"
                                Content="Join"
                                KeyboardNavigation.TabIndex="1"
                                Command="{Binding JoinCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource Inverse}}" />
                        <TextBox x:Name="CodeBox"
                                 Classes="Connect"
                                 KeyboardNavigation.TabIndex="0"
                                 MaxLength="8"
                                 AutomationProperties.Name="Code to join"
                                 AutomationProperties.HelpText="Enter to join"
                                 IsEnabled="{Binding IsBusy, Converter={StaticResource Inverse}}"
                                 Watermark="Client code"
                                 Text="{Binding ConnectionCode}">
                            <TextBox.KeyBindings>
                                <KeyBinding Gesture="Enter" Command="{Binding JoinCommand}" />
                            </TextBox.KeyBindings>
                        </TextBox>
                    </DockPanel>

                    <TextBlock Classes="Note"
                               Text="{Binding ControlStatus}" />

                    <TextBlock Classes="Note"
                               Text="Note: Make sure that all clients see each other after connecting." />
                </StackPanel>
            </Border>

            <!-- <Border Grid.Row="2" -->
            <!--         Classes="Card"> -->
            <!--     <StackPanel Spacing="10"> -->
            <!--         <DockPanel> -->
            <!--             <PathIcon Classes="CardTitle" -->
            <!--                       Data="{StaticResource settings_regular}" /> -->
            <!--             <TextBlock Classes="CardTitle" -->
            <!--                        Text="Configure" /> -->
            <!--         </DockPanel> -->
            <!-- -->
            <!--         <DockPanel> -->
            <!--             <Button DockPanel.Dock="Right" -->
            <!--                     Classes="TakeControl" -->
            <!--                     Content="Take Control" -->
            <!--                     IsEnabled="{Binding ShowTakeControl}" -->
            <!--                     Command="{Binding TakeControlCommand}"/> -->
            <!--             <TextBlock Classes="Aircraft" -->
            <!--                        IsVisible="{Binding Aircraft, Converter={StaticResource NotEmpty}}" -->
            <!--                        Text="{Binding Aircraft, StringFormat='Loaded {0}'}" /> -->
            <!--             ~1~ <ComboBox Classes="Aircraft"  @1@ -->
            <!--             ~1~           ItemsSource="{Binding Configurations}" @1@ -->
            <!--             ~1~           SelectedItem="{Binding SelectedConfiguration}" /> @1@ -->
            <!--         </DockPanel> -->
            <!--         <TextBlock Classes="Note ErrorNote" -->
            <!--                    IsVisible="{Binding NotSupported}" -->
            <!--                    Text="Aircraft is not supported." /> -->
            <!--     </StackPanel> -->
            <!-- </Border> -->

            <Border Grid.Row="2"
                    Classes="Card">
                <StackPanel Spacing="10">
                    <DockPanel>
                        <PathIcon Classes="CardTitle"
                                  Data="{StaticResource headset_regular}" />
                        <TextBlock Classes="CardTitle"
                                   Text="ATC &amp; Traffic" />
                    </DockPanel>

                    <!-- Traffic: our toggle, or who shares it -->
                    <DockPanel Classes="ShareRow">
                        <ToggleSwitch DockPanel.Dock="Right"
                                      Classes="Share"
                                      AutomationProperties.Name="Share traffic"
                                      AutomationProperties.HelpText="One pilot at a time"
                                      IsChecked="{Binding Share.TrafficOn}"
                                      IsEnabled="{Binding Share.TrafficCanHost}"
                                      IsVisible="{Binding Share.TrafficSharedBy, Converter={StaticResource Empty}}" />
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Classes="ShareHeading">
                                <TextBlock Classes="ShareLabel"
                                           Text="Traffic" />
                                <TextBlock Classes="ShareStatus"
                                           Text="{Binding Share.TrafficHint}"
                                           IsVisible="{Binding Share.TrafficHint, Converter={StaticResource NotEmpty}}" />
                                <TextBlock Classes="ShareStatus"
                                           Text="{Binding Share.TrafficSharedBy}"
                                           IsVisible="{Binding Share.TrafficSharedBy, Converter={StaticResource NotEmpty}}" />
                            </StackPanel>
                            <TextBlock Classes="ShareStatus Warning"
                                       Text="Detected existing AI traffic in your sim. Disable to avoid duplicates."
                                       IsVisible="{Binding Share.ForeignTrafficWarning}" />
                        </StackPanel>
                    </DockPanel>

                    <!-- ATC audio: our toggle and app, or who shares it and our volume -->
                    <StackPanel Spacing="6">
                        <DockPanel Classes="ShareRow">
                            <ToggleSwitch DockPanel.Dock="Right"
                                          Classes="Share"
                                          AutomationProperties.Name="Share ATC"
                                          IsChecked="{Binding Share.AtcOn}"
                                          IsEnabled="{Binding Share.AtcCanHost}"
                                          IsVisible="{Binding Share.AtcSharedBy, Converter={StaticResource Empty}}" />
                            <StackPanel Classes="ShareHeading" VerticalAlignment="Center">
                                <TextBlock Classes="ShareLabel"
                                           Text="ATC Audio" />
                                <TextBlock Classes="ShareStatus"
                                           Text="{Binding Share.AtcStatus}"
                                           IsVisible="{Binding Share.AtcOn}" />
                                <TextBlock Classes="ShareStatus"
                                           Text="{Binding Share.AtcSharedBy}"
                                           IsVisible="{Binding Share.AtcSharedBy, Converter={StaticResource NotEmpty}}" />
                            </StackPanel>
                        </DockPanel>

                        <ComboBox Classes="Share"
                                  IsVisible="{Binding Share.AtcOn}"
                                  AutomationProperties.Name="ATC app"
                                  ItemsSource="{Binding Share.AtcApps}"
                                  IsDropDownOpen="{Binding Share.AtcDropDownOpen, Mode=TwoWay}"
                                  SelectedItem="{Binding Share.SelectedAtcApp}" />

                        <DockPanel Classes="VolumeRow"
                                   IsVisible="{Binding Share.AtcReceiving}">
                            <Button DockPanel.Dock="Right"
                                    Classes="Icon"
                                    AutomationProperties.Name="{Binding Share.MuteLabel}"
                                    Command="{Binding Share.ToggleMute}">
                                <Panel>
                                    <PathIcon Data="{StaticResource speaker_2_regular}"
                                              IsVisible="{Binding Share.AtcMuted, Converter={StaticResource Inverse}}" />
                                    <PathIcon Data="{StaticResource speaker_mute_regular}"
                                              IsVisible="{Binding Share.AtcMuted}" />
                                </Panel>
                            </Button>
                            <Slider Classes="Share"
                                    AutomationProperties.Name="ATC volume"
                                    Minimum="0"
                                    Maximum="100"
                                    SmallChange="5"
                                    LargeChange="10"
                                    Value="{Binding Share.AtcVolumePercent}" />
                        </DockPanel>
                    </StackPanel>

                    <TextBlock Classes="Note ErrorNote"
                               Text="{Binding Share.Notice}"
                               IsVisible="{Binding Share.Notice, Converter={StaticResource NotEmpty}}" />

                    <TextBlock Classes="Note"
                               Text="Join a session to share."
                               IsVisible="{Binding Share.NeedsSession}" />

                    <TextBlock Classes="Note"
                               TextWrapping="Wrap"
                               Text="Make sure everyone is on the same traffic pack and scenery to avoid traffic issues."
                               IsVisible="{Binding Share.ShowNote}" />
                </StackPanel>
            </Border>

            <Border Grid.Row="3"
                    Classes="Card Connections">
                <DockPanel>

                    <DockPanel Classes="ConnectionsCardTitle"
                               DockPanel.Dock="Top">
                        <PathIcon DockPanel.Dock="Left"
                                  Classes="CardTitle"
                                  Data="{StaticResource person_board_regular}" />
                        <TextBlock DockPanel.Dock="Left"
                                   Classes="CardTitle"
                                   Text="Onboard" />
                        <Button DockPanel.Dock="Right"
                                Classes="ResetStats"
                                Content="Reset Stats"
                                FontSize="10"
                                Margin="0,0,4,0"
                                Padding="6,2"
                                Command="{Binding ResetPacketLossCommand}"
                                IsEnabled="{Binding Connected}" />
                    </DockPanel>

                    <ScrollViewer Classes="Connections"
                                  DockPanel.Dock="Bottom">
                        <!-- A list box, not an items control: Avalonia exposes no automation element
                             for a template's panel, so each pilot needs a real list item to be one
                             thing a screen reader can land on and arrow through. -->
                        <ListBox ItemsSource="{Binding Connections}"
                                 Classes="Connections"
                                 AutomationProperties.Name="Pilots onboard">
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem" x:DataType="vm:ConnectionItem">
                                    <Setter Property="AutomationProperties.Name" Value="{Binding Description}" />
                                    <Setter Property="AutomationProperties.HelpText" Value="{Binding Details}" />
                                    <Setter Property="Padding" Value="0" />
                                </Style>
                            </ListBox.Styles>

                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:ConnectionItem">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="10"
                                                    AutomationProperties.AccessibilityView="Raw"
                                                    VerticalAlignment="Center">

                                                <PathIcon Foreground="#4CAF50"
                                                          Height="22"
                                                          IsVisible="{Binding QualityLevel, Converter={StaticResource QualityToBrush}, ConverterParameter=1}"
                                                          Data="{StaticResource cellular_data_1_regular}" />
                                                <PathIcon Foreground="#8BC34A"
                                                          Height="22"
                                                          IsVisible="{Binding QualityLevel, Converter={StaticResource QualityToBrush}, ConverterParameter=2}"
                                                          Data="{StaticResource cellular_data_2_regular}" />
                                                <PathIcon Foreground="#FFC107"
                                                          Height="22"
                                                          IsVisible="{Binding QualityLevel, Converter={StaticResource QualityToBrush}, ConverterParameter=3}"
                                                          Data="{StaticResource cellular_data_3_regular}" />
                                                <PathIcon Foreground="#FF9800"
                                                          Height="22"
                                                          IsVisible="{Binding QualityLevel, Converter={StaticResource QualityToBrush}, ConverterParameter=4}"
                                                          Data="{StaticResource cellular_data_4_regular}" />
                                                <PathIcon Foreground="#F44336"
                                                          Height="22"
                                                          IsVisible="{Binding QualityLevel, Converter={StaticResource QualityToBrush}, ConverterParameter=5}"
                                                          Data="{StaticResource cellular_data_5_regular}" />

                                                <StackPanel>
                                                    <StackPanel DockPanel.Dock="Top"
                                                                Orientation="Horizontal">
                                                        <TextBlock Text="{Binding PeerId}"
                                                                   Foreground="#8ec6ff"
                                                                   VerticalAlignment="Bottom"
                                                                   FontSize="14" />
                                                        <TextBlock Text="{Binding Name}"
                                                                   Margin="5, 0, 0, 0"
                                                                   FontSize="14" />
                                                    </StackPanel>

                                                    <StackPanel Orientation="Horizontal"
                                                                Spacing="4"
                                                                VerticalAlignment="Center">
                                                        <TextBlock Foreground="#94a3b8"
                                                                   FontSize="11"
                                                                   Text="{Binding Ping, StringFormat='PING: ~{0} ms'}" />
                                                        <TextBlock Foreground="#94a3b8"
                                                                   FontSize="11"
                                                                   Text="{Binding PacketLoss, StringFormat='LOSS: {0:F1}%'}" />
                                                        <Border Classes="Direct"
                                                                IsVisible="{Binding IsDirect}">
                                                            <TextBlock Classes="Direct"
                                                                       Text="direct" />
                                                        </Border>
                                                        <Border Classes="Relay"
                                                                IsVisible="{Binding IsDirect, Converter={StaticResource Inverse}}">
                                                            <TextBlock Classes="Relay"
                                                                       Text="relay" />
                                                        </Border>
                                                    </StackPanel>
                                                </StackPanel>
                                        </StackPanel>

                                        <Separator AutomationProperties.AccessibilityView="Raw"
                                                   IsVisible="{Binding HasSeparatorAfter}" />
                                        <!-- <Border Height="1" Background="#94a3b8" Margin="0,10,0,10" /> -->
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>

                </DockPanel>
            </Border>

            <StackPanel Grid.Row="4" Spacing="10">
                <Border x:Name="NotesCard"
                        IsVisible="{Binding Notes, Converter={StaticResource NotEmpty}}"
                        Classes="Card">
                    <StackPanel Spacing="10">
                        <DockPanel>
                            <PathIcon Classes="CardTitle"
                                      Data="{StaticResource important_regular}" />
                            <TextBlock Classes="CardTitle"
                                       Text="Profile Notes" />
                        </DockPanel>
                        <ScrollViewer Classes="Notes">
                            <TextBlock Classes="NotesText"
                                       Text="{Binding Notes}" />
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <Border IsVisible="{Binding NewProfileAvailable}"
                        Classes="Card Badge Info">
                    <DockPanel>
                        <Button DockPanel.Dock="Right"
                                Classes="Link"
                                Content="Download"
                                AutomationProperties.Name="Download profile"
                                Command="{Binding DownloadProfileCommand}"/>
                        <TextBlock>New profile available</TextBlock>
                    </DockPanel>
                </Border>

                <Border IsVisible="{Binding ErrorMessage, Converter={StaticResource Empty}}"
                        Classes="Card Badge Success">
                    <TextBlock Text="FS Copilot is ready to use. Have a nice flight." />
                </Border>

                <Border IsVisible="{Binding ErrorMessage, Converter={StaticResource NotEmpty}}"
                        Classes="Card Badge Error">
                    <TextBlock Text="{Binding ErrorMessage}" />
                </Border>
            </StackPanel>
        </Grid>

        <a11y:LiveAnnouncer />
    </Panel>
</Window>
